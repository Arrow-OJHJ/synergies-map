{
  // Cloudflare Workers config for the old domain (arrow-synergies-map.com).
  // The map itself now lives on GitHub Pages; this Worker serves only the
  // "this map has moved" notice in moved/, for every path on the old domain.
  "name": "arrow-synergies-map",
  "compatibility_date": "2025-05-01",
  // Serve only via the custom domain; the free *.workers.dev URL is disabled.
  "workers_dev": false,
  "assets": {
    "directory": "./moved",
    // Any path on the old domain returns the moved notice.
    "not_found_handling": "single-page-application"
  }
}
